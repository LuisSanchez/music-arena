# Comma-separated browser origins allowed to call this API.
# Include your Vercel production + preview URLs.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main-user.vercel.app

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional bind overrides for containers
# HOST=0.0.0.0
# PORT=8000

# Generation tuning
# CLASH_PROCESS_POOL=1          # 0 = sequential/thread fallback
# CLASH_WARM_POOL=1             # 0 = disable background warm pairs
# CLASH_WARM_DEPTH=1            # warm pairs kept per pace/bias key
# CLASH_CACHE_DIR=/tmp/clash-wav-cache

# Radio station queue (low-quality continuous stream)
# RADIO_WARM_DEPTH=4
# RADIO_WORKERS=1
# RADIO_WARM_POOL=1
